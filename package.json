{
  "name": "hoc-vui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0",
    "build": "node scripts/use-db.js auto && prisma generate && next build",
    "start": "next start",
    "start:network": "next start -H 0.0.0.0",
    "lint": "eslint",
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "db:check": "node scripts/check-db.js",
    "db:sqlite": "node scripts/use-db.js sqlite && prisma generate",
    "db:postgres": "node scripts/use-db.js postgresql && prisma generate",
    "typecheck": "node -e \"console.log('JS project — typecheck skipped')\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.1",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "phaser": "^3.90.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4"
  }
}
